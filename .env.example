# OVH API credentials are now configured via the browser setup wizard
# on first startup. They are stored in the SQLite database.
# Do NOT use environment variables for OVH secrets.

# Only set this if you want a different default before credentials are saved
# OVH_ENDPOINT=ovh-eu

# Caching (optional)
OVH_USE_CACHE=false
OVH_CACHE_TTL=300

# Persistence (optional; defaults to ./ovh-flash-monitor.db)
OVH_DB_PATH=ovh-flash-monitor.db

# CORS (optional; comma-separated origins, e.g. https://app.example.com)
# OVH_CORS_ORIGINS=[]

# Multi-channel notifications (all optional - leave blank to disable)
# OVH_TELEGRAM_BOT_TOKEN=
# OVH_TELEGRAM_CHAT_ID=
# OVH_DISCORD_WEBHOOK_URL=
# OVH_SLACK_WEBHOOK_URL=
# OVH_SMTP_HOST=
# OVH_SMTP_PORT=587
# OVH_SMTP_USERNAME=
# OVH_SMTP_PASSWORD=
# OVH_SMTP_FROM=
# OVH_NOTIFY_EMAIL_TO=
